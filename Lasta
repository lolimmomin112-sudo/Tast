            for _, ball in pairs(footballs:GetChildren()) do
                if ball.Name == "Ball" and ball:IsA("BasePart") then
                    local distance =
                        (ball.Position - rootPart.Position).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        best = ball
                    end
                end
            end

            return best
        end

        
        
        

