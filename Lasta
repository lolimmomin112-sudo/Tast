SaveManager:BuildConfigSection(TabSettings)
ThemeManager:ApplyToTab(TabSettings)

-- ============================================================
-- EXTERNAL BUTTONS (Limited)
-- ============================================================
local ExtAimbotBtn = Library:CreateExternalButton("Aimbot", "AIM", UDim2.new(0, 20, 0.5, -55), function()
    Settings.CameraAimbot = not Settings.CameraAimbot
    notify("Aimbot: " .. (Settings.CameraAimbot and "ON" or "OFF"))
end)
RegisterExternalButton(ExtAimbotBtn)
ExtAimbotBtn:SetVisible(false)

local ExtGrabBtn = Library:CreateExternalButton("GrabGun", "GRAB", UDim2.new(0, 20, 0.5, -10), function()
    GrabGunTeleport()
end)
RegisterExternalButton(ExtGrabBtn)
ExtGrabBtn:SetVisible(false)

local ExtKillAllBtn = Library:CreateExternalButton("KillAll", "KILL", UDim2.new(0, 120, 0.5, 35), function()
    Settings.AutoKillAll = not Settings.AutoKillAll
    notify("Auto Kill All: " .. (Settings.AutoKillAll and "ON" or "OFF"))
end)
RegisterExternalButton(ExtKillAllBtn)
ExtKillAllBtn:SetVisible(false)

local ExtFlyBtn = Library:CreateExternalButton("Fly", "FLY", UDim2.new(0, 120, 0.5, -55), function()
    ToggleFly(not Settings.FlyEnabled)
    notify("Fly: " .. (Settings.FlyEnabled and "ON" or "OFF"))
end)
RegisterExternalButton(ExtFlyBtn)
ExtFlyBtn:SetVisible(false)

-- ============================================================
-- STARTUP
-- ============================================================
notify("SCRIPTERKIDDO MM2 ULTIMATE loaded!")
notify("Press Right Control to open the menu")

-- Apply saved theme
pcall(function()
    ThemeManager:LoadDefault()
end)

pcall(function()
    SaveManager:LoadAutoloadConfig()
end)

-- Cleanup on unload
Library:OnUnload(function()
    Cleanup()
end)

return true