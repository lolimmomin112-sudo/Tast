local function GetMapSpawnPoint()
    local normal = workspace:FindFirstChild("Normal")
    local map = normal and normal:FindFirstChild("Map")
    if map then
        local spawns = map:FindFirstChild("SpawnPoints") or map:FindFirstChild("Spawns") or map:FindFirstChild("PlayerSpawn")
        if spawns then
            local children = spawns:GetChildren()
            if #children > 0 then
                return children[math.random(1, #children)]
            end
        end
    end
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") or child:IsA("Folder") then
            local nameLower = child.Name:lower()
            if nameLower:find("map") or nameLower == "normal" then
                local spawns = child:FindFirstChild("SpawnPoints", true) or child:FindFirstChild("Spawns", true) or child:FindFirstChild("PlayerSpawn", true)
                if spawns then
                    local children = spawns:GetChildren()
                    if #children > 0 then
                        return children[math.random(1, #children)]
                    end
                end
            end
        end
    end
    return nil
end

local function TeleportToActiveMap()
    if not Settings.AutoTeleportMap then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return end
    local spawnPart = GetMapSpawnPoint()
    if spawnPart then
        task.wait(4.5)
        if char and root and root.Parent and humanoid.Health > 0 then
            root.CFrame = spawnPart.CFrame * CFrame.new(0, 3, 0)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end
end

