function ToggleAutoFarm(enabled)
    config.AutoFarmCoins = enabled
    
    if autoFarmLoop then
        task.cancel(autoFarmLoop)
        autoFarmLoop = nil
    end
    
    if not enabled then return end
    
    local farmedCoins = {}
    
    autoFarmLoop = task.spawn(function()
        while config.AutoFarmCoins do
            local char = GetCharacter()
            local root = GetRootPart()
            local humanoid = GetHumanoid()
            
            if not char or not root or not humanoid or humanoid.Health <= 0 then
                task.wait(0.5)
            else
                local map = FindMap()
                if not map then
                    task.wait(1)
                else
                    local coins = map:FindFirstChild("CoinContainer") or map:FindFirstChild("CoinAreas") or map:FindFirstChild("Coins")
                    if not coins then
                        task.wait(1)
                    else
                        local target = nil
                        local targetDist = math.huge
                        local pos = root.Position
                        
                        for _, child in pairs(coins:GetChildren()) do
                            local visual = child:FindFirstChild("CoinVisual") or child
                            if visual and (visual:IsA("BasePart") or visual:IsA("UnionOperation")) and visual.Transparency < 1 and not farmedCoins[visual] then
                                local dist = (visual.Position - pos).Magnitude
                                if dist < config.AutoFarmRadius and dist < targetDist then
                                    target = visual
                                    targetDist = dist
                                end
                            end
                        end
                        
                        if not target then
                            task.wait(0.5)
                        else
                            local targetPos = target.Position + Vector3.new(0, config.AutoFarmOffset, 0)
                            local speed = targetDist / math.max(config.AutoFarmSpeed, 1)
                            speed = math.max(speed, 0.1)
                            
                            -- Move to coin
                            local startTime = tick()
                            while tick() - startTime < speed + 0.1 and config.AutoFarmCoins and target and target.Parent and target.Transparency < 1 do
                                root.CFrame = CFrame.new(root.Position, targetPos)
                                task.wait()
                            end
                            
                            -- Collect coin
                            if target and target.Parent then
                                local collect = target.Parent:IsA("BasePart") and target.Parent or target
                                if firetouchinterest then
                                    pcall(function()
                                        firetouchinterest(root, collect, 0)
                                        firetouchinterest(root, collect, 1)
                                    end)
                                end
                                farmedCoins[target] = true
                                task.wait(config.AutoFarmDelay)
                            end
                        end
                    end
                end
            end
            task.wait()
        end
    end)
end

