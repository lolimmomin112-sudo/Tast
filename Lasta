local godModeConnection = nil

local function ToggleGodMode(enabled)
    Config.GodMode = enabled
    
    if godModeConnection then
        godModeConnection:Disconnect()
        godModeConnection = nil
    end
    
    if enabled then
        local function handleHumanoid(humanoid)
            if not humanoid then return end
            
            local conn = humanoid.HealthChanged:Connect(function(health)
                if Config.GodMode and health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
            end)
            table.insert(Connections, conn)
            
            task.spawn(function()
                while Config.GodMode and humanoid.Parent do
                    if humanoid.Health < humanoid.MaxHealth then
                        humanoid.Health = humanoid.MaxHealth
                    end
                    if humanoid:GetState() == Enum.HumanoidStateType.Dead then
                        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                        humanoid.Health = humanoid.MaxHealth
                    end
                    task.wait(0.2)
                end
            end)
        end
        
        local char = localPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then handleHumanoid(hum) end
        end
        
        local conn = localPlayer.CharacterAdded:Connect(function(char)
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then handleHumanoid(hum) end
        end)
        table.insert(Connections, conn)
        godModeConnection = conn
    end
    
    return true
end

