local function searchScriptBlox(query)
	if not query or query:gsub("%s+", "") == "" then
		Rayfield:Notify({ Title = "ScriptBlox", Content = "Please enter a search term.", Duration = 2 })
		return
	end

	Rayfield:Notify({ Title = "ScriptBlox", Content = "Searching ScriptBlox for: " .. query, Duration = 2 })

	pcall(function()
		local url = "https://scriptblox.com/api/script/search?q=" .. urlEncode(query) .. "&mode=free&page=1"
		local response = game:HttpGet(url)
		local data = HttpService:JSONDecode(response)

		if data and data.result and data.result.scripts and #data.result.scripts > 0 then
			fetchedScripts = data.result.scripts
			Rayfield:Notify({
				Title = "ScriptBlox Success",
				Content = string.format("Found %d scripts on ScriptBlox!", #fetchedScripts),
				Duration = 3
			})

			local topScript = fetchedScripts[1]
			if topScript and topScript.script then
				scriptTextBox.Text = "-- ScriptBlox: " .. tostring(topScript.title) .. "\n-- Game: " .. tostring(topScript.game and topScript.game.name or "Universal") .. "\n\n" .. topScript.script
			end
		else
			Rayfield:Notify({ Title = "ScriptBlox", Content = "No scripts found for that search.", Duration = 2.5 })
		end
	end)
end

ScriptBloxTab:CreateButton({
	Name = "ðŸ”Ž Search ScriptBlox",
