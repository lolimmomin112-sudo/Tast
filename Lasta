-- ============================================================
-- FLING TARGET
-- ============================================================
local function FlingTarget(target)
    if not target or not target.Character then return end
    
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if not char or not hum or not root then return end
    
    local targetChar = target.Character
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHead = targetChar:FindFirstChild("Head")
    
    if not targetHum or not targetRoot then return end
    
    local oldFPDH = workspace.FallenPartsDestroyHeight
    workspace.FallenPartsDestroyHeight = -50000
    
    if root.AssemblyLinearVelocity.Magnitude < 50 then
        getgenv().OldPos = root.CFrame
    end
    
    if targetHead then
        workspace.CurrentCamera.CameraSubject = targetHead
    elseif targetRoot then
        workspace.CurrentCamera.CameraSubject = targetRoot
    end
    
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Name = "VisionHub_FlingVelocity"
    bodyVel.Parent = root
    bodyVel.Velocity = Vector3.new(10000, 10000, 10000)
    bodyVel.MaxForce = Vector3.new(1e999, 1e999, 1e999)
    
    local bodyAngVel = Instance.new("BodyAngularVelocity")
    bodyAngVel.Name = "VisionHub_SpinVelocity"
    bodyAngVel.Parent = root
    bodyAngVel.AngularVelocity = Vector3.new(10000, 10000, 10000)
    bodyAngVel.MaxTorque = Vector3.new(1e999, 1e999, 1e999)
    
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    
    local startTime = tick()
    local spin = 0
    
    while targetChar.Parent and hum and hum.Health > 0 and tick() - startTime < 2.5 do
        if root and root.Parent then
            if targetRoot and targetRoot.AssemblyLinearVelocity.Magnitude < 50 then
                spin = spin + 100
                
                local positions = {
                    CFrame.new(0, 1.5, 0) + targetHum.MoveDirection * targetRoot.AssemblyLinearVelocity.Magnitude / 1.25,
                    CFrame.new(0, -1.5, 0) + targetHum.MoveDirection * targetRoot.AssemblyLinearVelocity.Magnitude / 1.25,
                    CFrame.new(2.25, 1.5, -2.25) + targetHum.MoveDirection * targetRoot.AssemblyLinearVelocity.Magnitude / 1.25,
                    CFrame.new(-2.25, -1.5, 2.25) + targetHum.MoveDirection * targetRoot.AssemblyLinearVelocity.Magnitude / 1.25,
                }
                
                for _, pos in ipairs(positions) do
                    if root and root.Parent then
                        root.CFrame = CFrame.new(targetRoot.Position) * pos * CFrame.Angles(math.rad(spin), 0, 0)
                        root.AssemblyLinearVelocity = Vector3.new(10000, 10000, 10000)
                        root.AssemblyAngularVelocity = Vector3.new(10000, 10000, 10000)
                        task.wait()
                    end
                end
            else
                root.CFrame = CFrame.new(targetRoot.Position) * CFrame.new(0, 1.5, targetHum.WalkSpeed) * CFrame.Angles(math.rad(90), 0, 0)
                task.wait()
                root.CFrame = CFrame.new(targetRoot.Position) * CFrame.new(0, -1.5, -targetHum.WalkSpeed)
                task.wait()
            end
        end
    end
    
    bodyVel:Destroy()
    bodyAngVel:Destroy()
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.CurrentCamera.CameraSubject = hum
    hum:ChangeState("GettingUp")
    
    if getgenv().OldPos then
        root.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
    end
    
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
    
    workspace.FallenPartsDestroyHeight = oldFPDH or -500
end

