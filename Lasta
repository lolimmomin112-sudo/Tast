-- ============================================================
-- SILENT KNIFE THROW
-- ============================================================
local silentThrowTask = nil

local function ExecuteSilentThrow()
    if FindMurderer() ~= localPlayer then return end
    
    local char = localPlayer.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return end
    
    local knife = char:FindFirstChild("Knife") or localPlayer.Backpack and localPlayer.Backpack:FindFirstChild("Knife")
    if not knife then return end
    
    local events = knife:FindFirstChild("Events")
    if not events then return end
    local knifeThrown = events:FindFirstChild("KnifeThrown")
    if not knifeThrown then return end
    
    local closestTarget = nil
    local closestDist = Config.KnifeThrowAura
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
            if targetRoot and targetHum and targetHum.Health > 0 then
                local dist = (targetRoot.Position - root.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestTarget = player
                end
            end
        end
    end
    
    if not closestTarget then return end
    
    if knife.Parent == localPlayer.Backpack then
        hum:EquipTool(knife)
        task.wait(0.05)
    end
    
    local targetRoot = closestTarget.Character:FindFirstChild("HumanoidRootPart")
    local targetHum = closestTarget.Character:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not targetHum then return end
    
    local ping = 0.06
    local network = Stats:FindFirstChild("Network")
    if network then
        local statsItem = network:FindFirstChild("ServerStatsItem")
        if statsItem then
            local dataPing = statsItem:FindFirstChild("Data Ping")
            if dataPing then
                ping = dataPing:GetValue() / 1000
            end
        end
    end
    
    local delay = ping + 0.05
    delay = math.clamp(delay, 0.01, 1)
    
    local pos = targetRoot.Position
    local vel = targetRoot.AssemblyLinearVelocity
    
    if vel.Magnitude < 0.5 and targetHum.MoveDirection.Magnitude > 0 then
        vel = targetHum.MoveDirection * targetHum.WalkSpeed
    end
    
    local predicted = pos + vel * delay
    
    if targetHum.FloorMaterial == Enum.Material.Air then
        predicted = predicted - Vector3.new(0, 0.5 * workspace.Gravity * delay ^ 2, 0)
    end
    
    if predicted.Y < pos.Y - 1 and targetHum.FloorMaterial ~= Enum.Material.Air then
        predicted = Vector3.new(predicted.X, pos.Y, predicted.Z)
    end
    
    pcall(function()
        knifeThrown:FireServer(CFrame.new(root.Position), CFrame.new(predicted))
    end)
end

local function ToggleSilentThrow(enabled)
    Config.SilentThrow = enabled
    
    if silentThrowTask then
        task.cancel(silentThrowTask)
        silentThrowTask = nil
    end
    
    if enabled then
        silentThrowTask = task.spawn(function()
            while Config.SilentThrow do
                if FindMurderer() == localPlayer then
                    pcall(ExecuteSilentThrow)
                end
                task.wait(0.4)
            end
        end)
    end
end

