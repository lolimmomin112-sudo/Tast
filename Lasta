        local v8SecondaryConnections = {}
        local v8SecondaryMarkers = {}
        local v8SecondaryRecords = {}

        local v8SecondarySize = 0
        local v8SecondaryTransparency = 1

        local function v8CreateSecondaryMarker(ball)
            if not ball or not ball:IsA("BasePart") then
                return
            end

            local marker = Instance.new("Part")
            marker.Name = "AirDribbleHelper"
            marker.Size = Vector3.new(
                v8SecondarySize,
                0.5,
                v8SecondarySize
            )
            marker.Anchored = true
            marker.CanCollide = true
            marker.CanTouch = false
            marker.CanQuery = false
            marker.Transparency =
                v8SecondaryTransparency
            marker.Material = Enum.Material.Neon
            marker.Color = Color3.fromRGB(0, 0, 0)
            marker.Parent = workspace

            table.insert(
                v8SecondaryMarkers,
                marker
            )

            table.insert(
                v8SecondaryRecords,
                {
                    Ball = ball,
                    Marker = marker,
                }
            )
        end

        local function v8UpdateSecondaryMarkers()
            for index = #v8SecondaryRecords, 1, -1 do
                local record =
                    v8SecondaryRecords[index]

                local ball = record.Ball
                local marker = record.Marker

                if not ball or not ball.Parent then
                    if marker then
                        local markerIndex =
                            table.find(
                                v8SecondaryMarkers,
                                marker
                            )

                        if markerIndex then
                            table.remove(
                                v8SecondaryMarkers,
                                markerIndex
                            )
                        end

                        if marker.Parent then
                            marker:Destroy()
                        end
                    end

                    table.remove(
                        v8SecondaryRecords,
                        index
                    )
                elseif marker and marker.Parent then
                    marker.CFrame = CFrame.new(
                        ball.Position.X,
                        ball.Position.Y - 1.2,
                        ball.Position.Z
                    )
                end
            end
        end

        local function v8ScanSecondaryMarkers()
            local footballs =
                workspace:FindFirstChild("Footballs")

            if not footballs then
                return
            end

            for _, ball in ipairs(footballs:GetChildren()) do
                if ball:IsA("BasePart") then
                    v8CreateSecondaryMarker(ball)
                end
            end
        end

        local function v8ConnectSecondaryChildAdded()
            local footballs =
                workspace:FindFirstChild("Footballs")

            if not footballs then
                return
            end

            local connection =
                footballs.ChildAdded:Connect(function(ball)
                    task.wait(0.1)

                    if ball:IsA("BasePart") then
                        v8CreateSecondaryMarker(ball)
                    end
                end)

            table.insert(
                v8SecondaryConnections,
                connection
            )
        end

        
        
        local function v8CleanupSecondaryAir()
            for _, connection in pairs(v8SecondaryConnections) do
                pcall(function()
                    connection:Disconnect()
                end)
            end

            v8SecondaryConnections = {}

            for _, marker in pairs(v8SecondaryMarkers) do
                pcall(function()
                    marker:Destroy()
                end)
            end

            v8SecondaryMarkers = {}
            v8SecondaryRecords = {}
        end

        table.insert(
            v8SecondaryConnections,
            V8RunService.RenderStepped:Connect(
                v8UpdateSecondaryMarkers
            )
        )

        v8ScanSecondaryMarkers()
        v8ConnectSecondaryChildAdded()

        Callbacks.AirDribbleSize = function(text)
            local value = tonumber(text)

            if not value then
                return
            end

            v8SecondarySize = value

            for index = #v8SecondaryMarkers, 1, -1 do
                local marker =
                    v8SecondaryMarkers[index]

                if marker and marker.Parent then
                    marker.Size =
                        Vector3.new(
                            value,
                            0.5,
                            value
                        )
                else
                    table.remove(
                        v8SecondaryMarkers,
                        index
                    )
                end
            end
        end

        Callbacks.AirDribbleTransparency = function(text)
            local value = tonumber(text)

            if not value then
                return
            end

            v8SecondaryTransparency = value

            for index = #v8SecondaryMarkers, 1, -1 do
                local marker =
                    v8SecondaryMarkers[index]

                if marker and marker.Parent then
                    marker.Transparency = value
                else
                    table.remove(
                        v8SecondaryMarkers,
                        index
                    )
                end
            end
        end

        
        Callbacks._CleanupSecondaryAir =
            v8CleanupSecondaryAir

        return Callbacks

