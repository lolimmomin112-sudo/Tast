local function MonitorRoles(player)
    if player == LocalPlayer then return end
    
    local function onChildAdded(child)
        if not Settings.EarlyRoleDetect then return end
        if child:IsA("Tool") then
            if child.Name == "Knife" then
                notify(player.DisplayName .. " is MURDERER!", 4)
            elseif child.Name == "Gun" then
                notify(player.DisplayName .. " is SHERIFF!", 4)
            end
        end
    end
    
    if player.Character then
        for _, child in ipairs(player.Character:GetChildren()) do
            onChildAdded(child)
        end
        player.Character.ChildAdded:Connect(onChildAdded)
    end
    player.CharacterAdded:Connect(function(char)
        for _, child in ipairs(char:GetChildren()) do
            onChildAdded(child)
        end
        char.ChildAdded:Connect(onChildAdded)
    end)
end

for _, p in pairs(Players:GetPlayers()) do
    MonitorRoles(p)
end
