local CoinCache = {}
local CollectedCoins = {}

local function GetCoinContainer()
    return Workspace:FindFirstChild("CoinContainer", true)
end

local function ScanCoins()
    table.clear(CoinCache)
    local container = GetCoinContainer()
    if container then
        for _, coin in ipairs(container:GetDescendants()) do
            if coin:IsA("BasePart") and coin.Name:lower():find("coin") then
                table.insert(CoinCache, coin)
            end
        end
    end
end

task.spawn(function()
    while true do
        if Settings.CoinFarmEnabled then
            ScanCoins()
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local best, bd = nil, math.huge
                for _, coin in ipairs(CoinCache) do
                    if coin and coin.Parent and not CollectedCoins[coin] then
                        local dist = (root.Position - coin.Position).Magnitude
                        if dist < Settings.CoinMaxDistance and dist < bd then
                            bd, best = dist, coin
                        end
                    end
                end
                if best then
                    local originalCF = root.CFrame
                    root.CFrame = best.CFrame * CFrame.new(0, -1, 0)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    if firetouchinterest then
                        firetouchinterest(root, best, 1)
                        firetouchinterest(root, best, 0)
                    end
                    CollectedCoins[best] = true
                    task.wait(0.1)
                    root.CFrame = originalCF
                end
            end
        end
        task.wait(0.5)
    end
end)

