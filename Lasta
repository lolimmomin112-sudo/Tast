function FlingTarget(target)
    if not target or not target.Character then return end
    
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and (char:FindFirstChild("HumanoidRootPart") or humanoid and humanoid.RootPart)
    
    if not char or not humanoid or not root then return end
    
    local tChar = target.Character
    local tHumanoid = tChar:FindFirstChildOfClass("Humanoid")
    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHead = tChar:FindFirstChild("Head")
    
    if not tChar or not tHumanoid or not tRoot then return end
    
    local oldFPDH = Workspace.FallenPartsDestroyHeight
    Workspace.FallenPartsDestroyHeight = -50000
    
    local vel = Instance.new("BodyVelocity")
    vel.Name = "ScripterkiddoFlingVelocity"
    vel.Parent = root
    vel.Velocity = Vector3.new(10000, 10000, 10000)
    vel.MaxForce = Vector3.new(1e999, 1e999, 1e999)
    
    local angVel = Instance.new("BodyAngularVelocity")
    angVel.Name = "ScripterkiddoSpinVelocity"
    angVel.Parent = root
    angVel.AngularVelocity = Vector3.new(10000, 10000, 10000)
    angVel.MaxTorque = Vector3.new(1e999, 1e999, 1e999)
    
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    
    local startTime = tick()
    while tick() - startTime < 2.5 and tRoot and tRoot.Parent == tChar do
        if tRoot.AssemblyLinearVelocity.Magnitude < 50 then
            root.CFrame = CFrame.new(tRoot.Position) * CFrame.new(0, 1.5, 0)
            root.AssemblyLinearVelocity = Vector3.new(10000, 10000, 10000)
        end
        task.wait()
    end
    
    vel:Destroy()
    angVel:Destroy()
    
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    Workspace.CurrentCamera.CameraSubject = humanoid
    humanoid:ChangeState("GettingUp")
    
    Workspace.FallenPartsDestroyHeight = oldFPDH or -500
end

