        local dir = (root.CFrame * CFrame.Angles(0, angle, 0)).LookVector
        local r = workspace:Raycast(root.Position, dir * Settings.WallHopDist, params)
        if r and r.Instance.CanCollide then
            isNearWall = true
            break
        end
    end
    
    if isNearWall and hum.FloorMaterial == Enum.Material.Air then
        lastWallHopTime = tick()
        canWallJump = false
        local jumpPower = hum.JumpPower > 0 and hum.JumpPower or 50
        root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, jumpPower * 0.95, root.AssemblyLinearVelocity.Z)
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
