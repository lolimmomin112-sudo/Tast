local guiButtons = {}

local function CreateGuiButton(id, config, callback)
    if guiButtons[id] then
        guiButtons[id]:Destroy()
    end
    
    if config.Enabled == false then return end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "Scripterkiddo_Button_" .. id
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.Parent = CoreGui or localPlayer:FindFirstChildOfClass("PlayerGui")
    guiButtons[id] = screenGui
    
    local button = Instance.new("ImageButton")
    button.Name = "Main"
    button.Size = UDim2.fromOffset(55, 55)
    button.Position = UDim2.fromScale(0.5, 0.5)
    button.AnchorPoint = Vector2.new(0.5, 0.5)
    button.BackgroundTransparency = 1
    button.Parent = screenGui
    
    local frame = Instance.new("Frame")
    frame.Name = "Visual"
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(11, 14, 20)
    frame.BackgroundTransparency = 0.4
    frame.BorderSizePixel = 0
    frame.Parent = button
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.25, 0)
    corner.Parent = frame
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 191, 255)
    stroke.Transparency = 0.8
    stroke.Thickness = 1
    stroke.Parent = frame
    
    local content = config.Type == "Text" and Instance.new("TextLabel") or Instance.new("ImageLabel")
    content.BackgroundTransparency = 1
    content.Size = UDim2.fromScale(0.85, 0.85)
    content.Position = UDim2.fromScale(0.5, 0.5)
    content.AnchorPoint = Vector2.new(0.5, 0.5)
    content.Parent = frame
    
    if config.Type == "Text" then
        content.Text = (config.Text or id:sub(1, 3)):upper()
        content.TextColor3 = Color3.fromRGB(255, 255, 255)
        content.Font = Enum.Font.GothamMedium
        content.TextScaled = true
    else
        content.Image = config.Icon or ""
        content.ImageColor3 = Color3.fromRGB(255, 255, 255)
    end
    
    local resizeGrip = Instance.new("Frame")
    resizeGrip.Name = "ResizeGrip"
    resizeGrip.Size = UDim2.fromOffset(26, 26)
    resizeGrip.Position = UDim2.fromScale(1, 1)
    resizeGrip.AnchorPoint = Vector2.new(1, 1)
    resizeGrip.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    resizeGrip.Visible = not Config.ButtonsLocked
    resizeGrip.Parent = button
    
    local gripCorner = Instance.new("UICorner")
    gripCorner.CornerRadius = UDim.new(1, 0)
    gripCorner.Parent = resizeGrip
    
    local isDragging = false
    local isResizing = false
    local startPos = nil
    local startSize = nil
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if Config.ButtonsLocked then
                if callback then
                    task.spawn(callback)
                end
            else
                isDragging = true
                startPos = input.Position
            end
        end
    end)
    
    resizeGrip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isResizing = true
            startSize = button.Size.X.Offset
            startPos = input.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startPos
            local viewport = camera.ViewportSize
            local newX = button.Position.X.Scale + delta.X / viewport.X
            local newY = button.Position.Y.Scale + delta.Y / viewport.Y
            button.Position = UDim2.fromScale(math.clamp(newX, 0.02, 0.98), math.clamp(newY, 0.02, 0.98))
            startPos = input.Position
        end
        
        if isResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position.X - startPos.X
            local newSize = math.clamp(startSize + delta, 35, 200)
            button.Size = UDim2.fromOffset(newSize, newSize)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
            isResizing = false
        end
    end)
end

