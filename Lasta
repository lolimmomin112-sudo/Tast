        local v8MainAirSize = 9
        local v8MainAirEnabled = false
        local v8MainAirMarkers = {}
        local v8MainAirByBall = {}

        local function v8CreateMainAirMarker(ball)
            if not v8MainAirEnabled then
                return
            end

            if not ball
                or not ball.Parent
                or not ball:IsA("BasePart") then
                return
            end

            local previous = v8MainAirByBall[ball]

            if previous and previous.Parent then
                return
            end

            local marker = Instance.new("Part")
            marker.Name = "A"
            marker.Size = Vector3.new(
                v8MainAirSize,
                1,
                v8MainAirSize
            )
            marker.Anchored = true
            marker.CanCollide = false
            marker.CanTouch = false
            marker.CanQuery = false
            marker.Transparency = 1
            marker.Material = Enum.Material.Neon
            marker.Color = Color3.fromRGB(128, 128, 128)
            marker.Parent = workspace

            v8MainAirByBall[ball] = marker

            table.insert(
                v8MainAirMarkers,
                marker
            )

            task.spawn(function()
                while v8MainAirEnabled
                    and marker.Parent
                    and ball.Parent do
                    marker.CFrame = CFrame.new(
                        ball.Position.X,
                        ball.Position.Y - 1.2,
                        ball.Position.Z
                    )

                    task.wait()
                end
            end)
        end

        
        local v8MainAirHumanoid

        do
            local character = V8LocalPlayer.Character

            if character then
                v8MainAirHumanoid =
                    character:WaitForChild("Humanoid")
            end
        end

        V8RunService.Heartbeat:Connect(function()
            if not v8MainAirHumanoid then
                return
            end

            local state =
                v8MainAirHumanoid:GetState()

            local active =
                state == Enum.HumanoidStateType.Jumping
                or state == Enum.HumanoidStateType.Freefall

            for _, marker in pairs(v8MainAirMarkers) do
                if marker and marker.Parent then
                    marker.CanCollide = active
                    marker.CanTouch = active
                    marker.CanQuery = active
                    marker.Transparency = 1
                end
            end
        end)

        local function v8RemoveMainMarker(ball)
            local marker = v8MainAirByBall[ball]

            if not marker then
                return
            end

            if marker.Parent then
                marker:Destroy()
            end

            v8MainAirByBall[ball] = nil

            for index, object in pairs(v8MainAirMarkers) do
                if object == marker then
                    table.remove(
                        v8MainAirMarkers,
                        index
                    )
                    break
                end
            end
        end

