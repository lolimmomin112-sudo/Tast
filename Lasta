-- Get target for aimbot
local function GetAimbotTarget()
    local role = GetMM2Role(LocalPlayer)
    local targetRole = (role == "Murderer") and "Innocent" or (role == "Sheriff" and "Murderer" or nil)
    if not targetRole then return nil end
    
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestDist = nil, math.huge
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = GetTargetPart(p.Character, Settings.TargetPart)
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local pRole = GetMM2Role(p)
                if pRole == targetRole or (role == "Murderer" and pRole ~= "Murderer") then
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if dist <= Settings.FOVSize and dist < bestDist then
                            bestDist = dist
                            best = root
                        end
                    end
                end
            end
        end
    end
    return best
end

