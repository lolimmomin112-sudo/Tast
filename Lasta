local function rnd(len)
    local pool = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local out = {}
    for i = 1, (len or rndSeed:NextInteger(9, 15)) do
        local j = rndSeed:NextInteger(1, #pool)
        out[i] = pool:sub(j, j)
    end
    return table.concat(out)
end

