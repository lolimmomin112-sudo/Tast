local function GetMM2Role(player)
    if not player or not player.Character then return "Innocent" end
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
        return "Murderer"
    elseif char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    return "Innocent"
end

local function FindMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetMM2Role(p) == "Murderer" and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            return p
        end
    end
    return nil
end

local function FindSheriff()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetMM2Role(p) == "Sheriff" and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            return p
        end
    end
    return nil
end

local function GetTargetByRole(role)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetMM2Role(p) == role then
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                return p
            end
        end
    end
    return nil
end

local function GetTargetPart(char, partName)
    if not char then return nil end
    if partName == "Head" then return char:FindFirstChild("Head") end
    if partName == "HumanoidRootPart" then return char:FindFirstChild("HumanoidRootPart") end
    if partName == "Torso" then return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") end
    return char:FindFirstChild("HumanoidRootPart")
end

local function ScanForDroppedGun()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj and obj.Name == "GunDrop" and obj:IsA("BasePart") then
            return obj
        end
    end
    return nil
end

local function SavePosition()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then SavedCFrame = root.CFrame end
end

local function LoadPosition()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root and SavedCFrame then root.CFrame = SavedCFrame end
end

local function SafeTouch(part1, part2, state)
    if firetouchinterest then
        pcall(firetouchinterest, part1, part2, state)
    end
end

local function Cleanup()
    for _, conn in ipairs(Connections) do
        if typeof(conn) == "RBXScriptConnection" and conn.Connected then
            pcall(conn.Disconnect, conn)
        end
    end
    table.clear(Connections)
    for _, v in pairs(ESPObjects) do
        pcall(function() v:Destroy() end)
    end
    table.clear(ESPObjects)
end

