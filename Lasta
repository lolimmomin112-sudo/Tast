        local function cloneClassicAppearance(sourceModel, targetCharacter, targetHumanoid)
            if not sourceModel then return end

            for _, object in pairs(targetCharacter:GetChildren()) do
                if object:IsA("Accessory")
                    or object:IsA("Shirt")
                    or object:IsA("Pants")
                    or object:IsA("BodyColors")
                    or object:IsA("CharacterMesh") then
                    object:Destroy()
                end
            end

            for _, object in pairs(sourceModel:GetChildren()) do
                if object:IsA("Accessory") then
                    targetHumanoid:AddAccessory(object:Clone())
                elseif object:IsA("Shirt")
                    or object:IsA("Pants")
                    or object:IsA("BodyColors")
                    or object:IsA("CharacterMesh") then
                    object:Clone().Parent = targetCharacter
                end
            end

            local targetHead = targetCharacter:FindFirstChild("Head")
            if targetHead then
                for _, child in pairs(targetHead:GetChildren()) do
                    if child:IsA("Decal")
                        and (child.Name == "face" or child.Name == "Face") then
                        child:Destroy()
                    end
                end

                local texture
                local sourceHead = sourceModel:FindFirstChild("Head")
                if sourceHead then
                    for _, child in ipairs(sourceHead:GetDescendants()) do
                        if child:IsA("Decal")
                            and (child.Name == "face" or child.Name == "Face") then
                            texture = child.Texture
                            break
                        end
                    end
                end

                local face = Instance.new("Decal")
                face.Name = "face"
                face.Face = Enum.NormalId.Front
                face.Texture = texture or "rbxasset://textures/face.png"
                face.Parent = targetHead
            end
        end

