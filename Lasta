-- Silent Aim
local lastShotTime = 0

local function FireGunAtTarget()
    local char = LocalPlayer.Character
    local gun = char and char:FindFirstChild("Gun")
    if not gun then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        gun = backpack and backpack:FindFirstChild("Gun")
        if not gun then
            notify("No gun found!")
            return
        end
    end
    
    local target = GetTargetByRole("Murderer") or SelectedPlayer
    if not target or not target.Character then
        notify("No target found!")
        return
    end
    
    local targetRoot = GetTargetPart(target.Character, Settings.TargetPart)
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not targetRoot or not myRoot then
        return
    end
    
    if os.clock() - lastShotTime < 0.35 then return end
    lastShotTime = os.clock()
    
    -- Equip gun
    if gun.Parent == LocalPlayer:FindFirstChild("Backpack") then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:EquipTool(gun)
            task.wait(0.05)
        end
    end
    
    local shoot = gun:FindFirstChild("Shoot")
    if shoot and shoot:IsA("RemoteEvent") then
        local targetPos = targetRoot.Position
        if Settings.SilentAimType == "Instant" or Settings.SilentAimType == "OP" then
            local ping = LocalPlayer:GetNetworkPing() or 0.05
            local vel = targetRoot.AssemblyLinearVelocity or Vector3.new()
            targetPos = targetPos + (vel * (ping + 0.05))
        end
        shoot:FireServer(myRoot.CFrame, CFrame.new(targetPos))
    end
end

