        local predictionBall

        Callbacks.BallPrediction = function(enabled)
            if enabled then
                predictionFolder,
                predictionBeam,
                predictionStart,
                predictionEnd,
                predictionMarker = createBallPredictionFX()

                predictionConnection = game:GetService("RunService").RenderStepped:Connect(function()
                    local ball = nearestFootballToPlayer()
                    local usable = ball
                        and ball.AssemblyLinearVelocity.Magnitude > 0.5

                    if usable then
                        if predictionBall ~= ball then
                            predictionBall = ball
                            predictionStart.Parent = ball
                        end

                        predictionFolder.Parent = workspace

                        local position = ball.Position
                        local velocity = ball.AssemblyLinearVelocity
                        local gravity = Vector3.new(0, -workspace.Gravity, 0)

                        
                        
                        local t = 1.2
                        local predicted =
                            position
                            + velocity * t
                            + gravity * 0.5 * 1.44

                        predictionEnd.Parent.Position = predicted

                        
                        
                        local fromStart = predicted - position
                        local fromEnd = position - predicted

                        predictionBeam.CurveSize0 = fromStart.Magnitude * 0.5
                        predictionBeam.CurveSize1 = fromEnd.Magnitude * 0.5

                        if fromStart.Magnitude > 0 then
                            predictionStart.WorldAxis = fromStart.Unit
                        end
                        if fromEnd.Magnitude > 0 then
                            predictionEnd.WorldAxis = fromEnd.Unit
                        end

                        predictionMarker.Position = predicted
                    else
                        if predictionFolder then
                            predictionFolder.Parent = nil
                        end

                        if predictionBall
                            and predictionBall.Parent
                            and predictionBall.Parent:IsA("BasePart")
                            and predictionBall.Parent.Name == "Football" then
                            
                            
                            predictionStart.Parent = predictionBall.Parent
                        end

                        predictionBall = nil
                    end
                end)
            else
                if predictionConnection then
                    predictionConnection:Disconnect()
                    predictionConnection = nil
                end

                if predictionFolder then
                    predictionFolder:Destroy()
                    predictionFolder = nil
                end

                predictionBeam = nil
                predictionStart = nil
                predictionEnd = nil
                predictionMarker = nil
                predictionBall = nil
            end
        end

        
