function Prediction()
    local murderer = FindMurderer()
    if murderer and murderer.Character then
        local humanoid = murderer.Character:FindFirstChild("Humanoid")
        local root = murderer.Character:FindFirstChild("HumanoidRootPart")
        
        if humanoid and humanoid.Health > 0 and root then
            local ping = 0.06
            local stats = Stats:FindFirstChild("Network")
            if stats then
                local item = stats:FindFirstChild("ServerStatsItem")
                if item then
                    local data = item:FindFirstChild("Data Ping")
                    if data then
                        ping = data:GetValue() / 1000
                    end
                end
            end
            
            local predict = ping + 0.04
            predict = math.clamp(predict, 0, 1)
            
            local pos = root.Position
            local vel = root.AssemblyLinearVelocity
            local dir = humanoid.MoveDirection
            
            if vel.Magnitude < 0.1 and dir.Magnitude > 0 then
                vel = dir * humanoid.WalkSpeed
            end
            
            local newPos = pos + vel * predict
            
            if humanoid.FloorMaterial == Enum.Material.Air then
                newPos = newPos + 0.5 * Vector3.new(0, -Workspace.Gravity, 0) * predict^2
            end
            
            if newPos.Y < pos.Y - 1 and humanoid.FloorMaterial ~= Enum.Material.Air then
                newPos = Vector3.new(newPos.X, pos.Y, newPos.Z)
            end
            
            return newPos
        end
    end
    return nil
end

function ShootMurderer()
    local char = GetCharacter()
    local root = GetRootPart()
    local backpack = GetBackpack()
    
    if not char or not root or not backpack then return false end
    
    local gun = char:FindFirstChild("Gun") or backpack:FindFirstChild("Gun")
    if not gun then return false end
    
    local target = Prediction()
    if not target then return false end
    
    local murderer = FindMurderer()
    if not murderer or not murderer.Character then return false end
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char, Workspace.CurrentCamera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local rootPos = root.Position
    local dir = target - rootPos
    
    if dir.Magnitude ~= 0 then
        local result = Workspace:Raycast(rootPos, dir.Unit * (dir.Magnitude + 2), params)
        
        if not result or not result.Instance or result.Instance:IsDescendantOf(murderer.Character) then
            if gun.Parent == backpack then
                gun.Parent = char
                task.wait()
            end
            
            local shoot = gun:FindFirstChild("Shoot")
            if shoot and shoot:IsA("RemoteEvent") then
                task.spawn(function()
                    pcall(function()
                        local cf = CFrame.lookAt(rootPos, target)
                        shoot:FireServer(cf, CFrame.new(target))
                    end)
                end)
                return true
            end
            
            local knifeLocal = gun:FindFirstChild("KnifeLocal")
            if knifeLocal then
                local createBeam = knifeLocal:FindFirstChild("CreateBeam")
                if createBeam then
                    local remote = createBeam:FindFirstChild("RemoteFunction")
                    if remote then
                        task.spawn(function()
                            pcall(function()
                                remote:InvokeServer(1, target, "AH2")
                            end)
                        end)
                        return true
                    end
                end
            end
        end
    end
    return false
end

