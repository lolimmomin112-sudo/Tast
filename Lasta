                end
            end
        end)
        
        local root = GetRootPart()
        if root then
            local gyro = Instance.new("BodyGyro")
            gyro.Name = "ScripterkiddoFlyGyro"
            gyro.P = 90000
            gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            gyro.CFrame = root.CFrame
            gyro.Parent = root
            
            local velocity = Instance.new("BodyVelocity")
            velocity.Name = "ScripterkiddoFlyVel"
            velocity.Velocity = Vector3.new(0, 0, 0)
            velocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            velocity.Parent = root
            
            local humanoid = GetHumanoid()
            
            flyConnection = RunService.RenderStepped:Connect(function()
                if config.FlyEnabled and root and root.Parent and humanoid and humanoid.Health > 0 then
                    humanoid.PlatformStand = true
                    gyro.CFrame = Workspace.CurrentCamera.CFrame
                    
                    local moveVec = Vector3.new(0, 0, 0)
                    if controlModule and controlModule.GetMoveVector then
                        pcall(function()
                            moveVec = controlModule:GetMoveVector()
                        end)
                    end
                    
                    local up = 0
                    if UserInputService:IsKeyDown(Enum.KeyCode.E) then up = 1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Q) then up = -1 end
                    
                    local speed = config.FlySpeed
                    if moveVec.Magnitude > 0 or up ~= 0 then
                        local cf = Workspace.CurrentCamera.CFrame
                        velocity.Velocity = cf.RightVector * moveVec.X * speed + cf.LookVector * -moveVec.Z * speed + Vector3.new(0, up * speed, 0)
                    else
                        velocity.Velocity = Vector3.new(0, 0, 0)
                    end
                else
                    ToggleFly(false)
                end
            end)
        end
    else
        local root = GetRootPart()
        if root then
            for _, child in pairs(root:GetChildren()) do
                if child.Name == "ScripterkiddoFlyGyro" or child.Name == "ScripterkiddoFlyVel" then
