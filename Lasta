                    if knifeStabbed then
                        knifeStabbed:FireServer()
                    end
                end
            end
        end)
        knifeAuraConnection = conn
        table.insert(Connections, conn)
    end
end

-- ============================================================
-- AUTO SHOOT MURDERER
-- ============================================================
local autoShootTask = nil

local function PredictPosition()
    local murderer = FindMurderer()
    if not murderer or not murderer.Character then return nil end
    
    local root = murderer.Character:FindFirstChild("HumanoidRootPart")
    local hum = murderer.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil end
    
    local ping = 0.06
    local network = Stats:FindFirstChild("Network")
    if network then
        local statsItem = network:FindFirstChild("ServerStatsItem")
        if statsItem then
            local dataPing = statsItem:FindFirstChild("Data Ping")
            if dataPing then
                ping = dataPing:GetValue() / 1000
            end
        end
    end
    
    local delay = ping + 0.05
    delay = math.clamp(delay, 0, 1)
    
    local pos = root.Position
    local vel = root.AssemblyLinearVelocity
    
    if vel.Magnitude < 0.1 and hum.MoveDirection.Magnitude > 0 then
        vel = hum.MoveDirection * hum.WalkSpeed
    end
    
    local predicted = pos + vel * delay
    
    if hum.FloorMaterial == Enum.Material.Air then
        predicted = predicted - Vector3.new(0, 0.5 * workspace.Gravity * delay ^ 2, 0)
    end
    
    if predicted.Y < pos.Y - 1 and hum.FloorMaterial ~= Enum.Material.Air then
        predicted = Vector3.new(predicted.X, pos.Y, predicted.Z)
    end
    
    return predicted
end

local function ShootMurderer()
    local murderer = FindMurderer()
    if not murderer or not murderer.Character then return false end
    
    local gun = localPlayer.Character and localPlayer.Character:FindFirstChild("Gun") or
                localPlayer.Backpack and localPlayer.Backpack:FindFirstChild("Gun")
    if not gun then return false end
    
    local root = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    local targetRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    local targetHum = murderer.Character:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not targetHum or targetHum.Health <= 0 then return false end
    
    local predictedPos = PredictPosition()
    if not predictedPos then return false end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {localPlayer.Character, camera}
    
    local result = workspace:Raycast(root.Position, (predictedPos - root.Position).Unit * (predictedPos - root.Position).Magnitude + 2, raycastParams)
    if result and not result.Instance:IsDescendantOf(murderer.Character) then
        return false
    end
    
    if gun.Parent == localPlayer.Backpack then
        gun.Parent = localPlayer.Character
        task.wait()
    end
    
    local shoot = gun:FindFirstChild("Shoot")
    if shoot and shoot:IsA("RemoteEvent") then
        pcall(function()
            shoot:FireServer(CFrame.lookAt(root.Position, predictedPos), CFrame.new(predictedPos))
        end)
        return true
    end
    
    return false
end

