        Callbacks.ImpactDistance = function(enabled)
            if enabled then
                impactFolder = Instance.new("Folder")
                impactFolder.Name = "ImpactDistanceFX"
                impactFolder.Parent = workspace

                impactPart = Instance.new("Part")
                impactPart.Shape = Enum.PartType.Cylinder
                impactPart.Size = Vector3.new(0.1, 4, 4)
                impactPart.Color = Color3.fromRGB(255, 76, 76)
                impactPart.Material = Enum.Material.Neon
                impactPart.Anchored = true
                impactPart.CanCollide = false
                impactPart.Transparency = 0.4
                impactPart.CFrame =
                    CFrame.new() * CFrame.Angles(0, 0, math.rad(90))
                impactPart.Parent = impactFolder

                impactConnection = game:GetService("RunService").RenderStepped:Connect(function()
                    local ball = nearestFootballToPlayer()

                    if not ball or ball.AssemblyLinearVelocity.Magnitude <= 0.5 then
                        if impactFolder then
                            impactFolder.Parent = nil
                        end
                        return
                    end

                    impactFolder.Parent = workspace

                    local position = ball.Position
                    local velocity = ball.AssemblyLinearVelocity
                    local gravity = Vector3.new(0, -workspace.Gravity, 0)

                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude

                    local player = game:GetService("Players").LocalPlayer
                    rayParams.FilterDescendantsInstances = {
                        player.Character
                    }

                    local impactPosition

                    
                    for t = 0, 3, 0.05 do
                        local nextT = t + 0.05

                        local p0 =
                            position
                            + velocity * t
                            + gravity * 0.5 * (t ^ 2)

                        local p1 =
                            position
                            + velocity * nextT
                            + gravity * 0.5 * (nextT ^ 2)

                        local hit = workspace:Raycast(
                            p0,
                            p1 - p0,
                            rayParams
                        )

                        if hit then
                            impactPosition = hit.Position
                            break
                        end
                    end

                    if impactPosition then
                        impactPart.Transparency = 0.4
                        impactPart.CFrame =
                            CFrame.new(impactPosition)
                            * CFrame.Angles(0, 0, math.rad(90))
                    else
                        impactPart.Transparency = 1
                    end
                end)
            else
                if impactConnection then
                    impactConnection:Disconnect()
                    impactConnection = nil
                end

                if impactFolder then
                    impactFolder:Destroy()
                    impactFolder = nil
                end

                impactPart = nil
            end
        end

        
