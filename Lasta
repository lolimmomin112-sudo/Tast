-- ============================================================
-- AUTO FARM
-- ============================================================
local farmTask = nil
local farmParts = {}
local farmPosControl = nil
local farmRotControl = nil
local farmGyro = nil
local isRoundActive = false

local function ToggleAutoFarm(enabled)
    Config.AutoFarmCoins = enabled
    
    if farmTask then
        task.cancel(farmTask)
        farmTask = nil
    end
    
    if farmPosControl then
        farmPosControl:Destroy()
        farmPosControl = nil
    end
    if farmRotControl then
        farmRotControl:Destroy()
        farmRotControl = nil
    end
    if farmGyro then
        farmGyro:Destroy()
        farmGyro = nil
    end
    
    if enabled then
        farmTask = task.spawn(function()
            while Config.AutoFarmCoins do
                if not isRoundActive then
                    task.wait(1)
                    continue
                end
                
                local char = localPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                if not char or not root or not hum or hum.Health <= 0 then
                    task.wait(0.5)
                    continue
                end
                
                ToggleNoclip(true)
                hum.PlatformStand = true
                
                local map = GetMap()
                local coins = map and (map:FindFirstChild("CoinContainer") or map:FindFirstChild("CoinAreas"))
                
                if not coins then
                    task.wait(1)
                    continue
                end
                
                if not farmPosControl or not farmPosControl.Parent then
                    if farmGyro then farmGyro:Destroy() end
                    if farmPosControl then farmPosControl:Destroy() end
                    if farmRotControl then farmRotControl:Destroy() end
                    
                    local att = Instance.new("Attachment")
                    att.Name = "Scripterkiddo_FarmPoint"
                    att.Parent = root
                    farmGyro = att
                    
                    local pos = Instance.new("AlignPosition")
                    pos.Mode = Enum.PositionAlignmentMode.OneAttachment
                    pos.Attachment0 = att
                    pos.RigidityEnabled = true
                    pos.Position = root.Position
                    pos.Parent = root
                    farmPosControl = pos
                    
                    local rot = Instance.new("AlignOrientation")
                    rot.Mode = Enum.OrientationAlignmentMode.OneAttachment
                    rot.Attachment0 = att
                    rot.RigidityEnabled = true
                    rot.CFrame = root.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                    rot.Parent = root
                    farmRotControl = rot
                end
                
                local targetCoin = nil
                local closestDist = math.huge
                local pos = root.Position
                
                for _, child in ipairs(coins:GetChildren()) do
                    local coin = child:FindFirstChild("CoinVisual") or child
                    if coin and coin:IsA("BasePart") and coin.Transparency < 1 and not farmParts[coin] then
                        local dist = (coin.Position - pos).Magnitude
                        if dist < Config.AutoFarmRadius and dist < closestDist then
                            closestDist = dist
                            targetCoin = coin
                        end
                    end
                end
                
                if not targetCoin then
                    task.wait(0.5)
                    continue
                end
                
                local targetPos = targetCoin.Position + Vector3.new(0, Config.AutoFarmOffset, 0)
                local duration = closestDist / math.max(Config.AutoFarmSpeed, 1)
                duration = math.max(duration, 0.1)
                
                if farmPosControl then
                    local tween = TweenService:Create(farmPosControl, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
                        Position = targetPos
                    })
                    tween:Play()
                    
                    local elapsed = 0
                    local completed = false
                    local conn = tween.Completed:Connect(function()
                        completed = true
                    end)
                    table.insert(Connections, conn)
                    
                    while elapsed < duration + 0.1 and not completed and Config.AutoFarmCoins and isRoundActive and root and root.Parent and targetCoin and targetCoin.Parent and targetCoin.Transparency < 1 and not farmParts[targetCoin] do
                        if farmRotControl then
                            farmRotControl.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(90), 0, 0)
                        end
                        elapsed = elapsed + RunService.Heartbeat:Wait()
                    end
                    conn:Disconnect()
                end
                
                if Config.AutoFarmCoins and isRoundActive and farmPosControl and targetCoin and targetCoin.Parent then
                    local coinPart = targetCoin.Parent:IsA("BasePart") and targetCoin.Parent or targetCoin
                    if firetouchinterest then
                        firetouchinterest(root, coinPart, 1)
                        firetouchinterest(root, coinPart, 0)
                    end
                    task.wait(Config.AutoFarmDelay)
                end
                
                farmParts[targetCoin] = true
                task.wait()
            end
        end)
    else
        ToggleNoclip(false)
        if localPlayer.Character then
            local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end
end

