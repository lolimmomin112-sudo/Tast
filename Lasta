function SilentThrow()
    if FindMurderer() ~= player then return end
    
    local char = GetCharacter()
    local root = GetRootPart()
    local humanoid = GetHumanoid()
    
    if not char or not root or not humanoid or humanoid.Health <= 0 then return end
    
    local knife = char:FindFirstChild("Knife") or GetBackpack():FindFirstChild("Knife")
    if not knife then return end
    
    local events = knife:FindFirstChild("Events")
    if not events then return end
    
    local thrown = events:FindFirstChild("KnifeThrown")
    if not thrown then return end
    
    -- Find nearest player
    local nearest = nil
    local nearestDist = math.huge
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChild("Humanoid")
            if r and h and h.Health > 0 then
                local dist = (r.Position - root.Position).Magnitude
                if dist < nearestDist and dist <= config.KnifeThrowAura then
                    nearest = p
                    nearestDist = dist
                end
            end
        end
    end
    
    if not nearest then return end
    
    if knife.Parent == GetBackpack() then
        humanoid:EquipTool(knife)
        task.wait(0.05)
    end
    
    local targetRoot = nearest.Character:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = nearest.Character:FindFirstChild("Humanoid")
    
    if targetRoot and targetHumanoid then
        local ping = 0.06
        local stats = Stats:FindFirstChild("Network")
        if stats then
            local item = stats:FindFirstChild("ServerStatsItem")
            if item then
                local data = item:FindFirstChild("Data Ping")
                if data then
                    ping = data:GetValue() / 1000
                end
            end
        end
        
        local predict = ping + 0.05
        predict = math.clamp(predict, 0.01, 1)
        
        local vel = targetRoot.AssemblyLinearVelocity
        if vel.Magnitude < 0.5 and targetHumanoid.MoveDirection.Magnitude > 0 then
            vel = targetHumanoid.MoveDirection * targetHumanoid.WalkSpeed
        end
        
        local targetPos = targetRoot.Position + vel * predict
        
        if targetHumanoid.FloorMaterial ~= Enum.Material.Air then
            if targetPos.Y < targetRoot.Position.Y - 1 then
                targetPos = Vector3.new(targetPos.X, targetRoot.Position.Y, targetPos.Z)
            end
        else
            targetPos = targetPos - Vector3.new(0, 0.5 * Workspace.Gravity * predict^2, 0)
        end
        
        pcall(function()
            thrown:FireServer(CFrame.new(root.Position), CFrame.new(targetPos))
        end)
    end
end

