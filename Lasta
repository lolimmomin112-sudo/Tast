function FindMap()
    for _, child in pairs(Workspace:GetChildren()) do
        if (child:FindFirstChild("CoinContainer") or child:FindFirstChild("CoinAreas")) and child:FindFirstChild("Spawns") then
            return child
        end
    end
    return nil
end

function FindLobby()
    for _, child in pairs(Workspace:GetChildren()) do
        if child:FindFirstChild("Lobby") then
            return child.Lobby
        end
        if child.Name:lower() == "lobby" then
            return child
        end
    end
    return nil
end

function GetPlayerByName(name)
    if name then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Name:lower() == name:lower() then
                return p
            end
        end
    end
    return nil
end

function FindMurderer()
    if playerData then
        for k, v in pairs(playerData) do
            if v.Role == "Murderer" then
                local p = GetPlayerByName(k)
                if p then return p end
            end
        end
    end
    for _, p in pairs(Players:GetPlayers()) do
        local backpack = p:FindFirstChild("Backpack")
        if backpack and backpack:FindFirstChild("Knife") or p.Character and p.Character:FindFirstChild("Knife") then
            return p
        end
    end
    return nil
end

function FindSheriff()
