local function FindMurderer()
    if PlayerData then
        for name, data in pairs(PlayerData) do
            if data.Role == "Murderer" then
                local player = Players:FindFirstChild(name)
                if player then return player end
            end
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local backpack = player:FindFirstChild("Backpack")
            if backpack and backpack:FindFirstChild("Knife") then
                return player
            end
            local char = player.Character
            if char and char:FindFirstChild("Knife") then
                return player
            end
        end
    end
    return nil
end

local function FindSheriff()
    if PlayerData then
        for name, data in pairs(PlayerData) do
            if data.Role == "Sheriff" or data.Role == "Hero" then
                local player = Players:FindFirstChild(name)
                if player then return player end
            end
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local backpack = player:FindFirstChild("Backpack")
            if backpack and backpack:FindFirstChild("Gun") then
                return player
            end
            local char = player.Character
            if char and char:FindFirstChild("Gun") then
                return player
            end
        end
    end
    return nil
end

local function IsInnocent(player)
    if player and PlayerData then
        local data = PlayerData[player.Name]
        if data and data.Role == "Innocent" then
            return true
        end
    end
    return false
end

local function GetTeamColor(player)
    if player == FindMurderer() then
        return Config.ESPColorMurderer
    elseif player == FindSheriff() then
        return Config.ESPColorSheriff
    elseif IsInnocent(player) then
        return Config.ESPColorInnocent
    end
    return Color3.fromRGB(255, 255, 255)
end

local function GetTeamName(player)
    if player == FindMurderer() then
        return "Murderer"
    elseif player == FindSheriff() then
        return "Sheriff"
    elseif IsInnocent(player) then
        return "Innocent"
    end
    return "Unknown"
end

