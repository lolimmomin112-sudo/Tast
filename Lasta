local function applyESP(targetPlayer)
	if targetPlayer == player then return end
	if targetPlayer.Character then
		local highlight = targetPlayer.Character:FindFirstChild("AdminESPHighlight")
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "AdminESPHighlight"
			highlight.FillColor = Color3.fromRGB(255, 30, 30)
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
			highlight.Parent = targetPlayer.Character
		end
		highlight.Enabled = espEnabled

		if espTagsEnabled then
			local head = targetPlayer.Character:FindFirstChild("Head")
			if head and not head:FindFirstChild("AdminESPTag") then
				local bb = Instance.new("BillboardGui")
				bb.Name = "AdminESPTag"
				bb.Size = UDim2.new(0, 120, 0, 40)
				bb.StudsOffset = Vector3.new(0, 2.5, 0)
				bb.AlwaysOnTop = true
				bb.Parent = head

				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1, 0, 1, 0)
				lbl.BackgroundTransparency = 1
				lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
				lbl.TextStrokeTransparency = 0
				lbl.Font = Enum.Font.GothamBold
				lbl.TextSize = 11
				lbl.Text = targetPlayer.Name
				lbl.Parent = bb
			end
		end
	end
end

