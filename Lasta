local function ToggleFly(enabled)
    Config.FlyEnabled = enabled
    
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    if flyGyro and flyGyro.Parent then flyGyro:Destroy() end
    if flyVel and flyVel.Parent then flyVel:Destroy() end
    flyGyro = nil
    flyVel = nil
    
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if enabled and root and hum then
        hum.PlatformStand = true
        
        flyGyro = Instance.new("BodyGyro")
        flyGyro.Name = "VisionFlyGyro"
        flyGyro.P = 90000
        flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyGyro.CFrame = root.CFrame
        flyGyro.Parent = root
        
        flyVel = Instance.new("BodyVelocity")
        flyVel.Name = "VisionFlyVel"
        flyVel.Velocity = Vector3.new(0, 0, 0)
        flyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyVel.Parent = root
        
        local cam = workspace.CurrentCamera
        
        local conn = RunService.RenderStepped:Connect(function()
            if not Config.FlyEnabled then
                ToggleFly(false)
                return
            end
            
            if not root or not root.Parent or not hum or hum.Health <= 0 then
                ToggleFly(false)
                return
            end
            
            hum.PlatformStand = true
            flyGyro.CFrame = cam.CFrame
            
            local moveVec = Vector3.new(0, 0, 0)
            if ControlModule and ControlModule.GetMoveVector then
                pcall(function()
                    moveVec = ControlModule:GetMoveVector()
                end)
            end
            
            local up = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then up = 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then up = -1 end
            
            if moveVec.Magnitude <= 0 and up == 0 then
                flyVel.Velocity = Vector3.new(0, 0, 0)
            else
                local cf = cam.CFrame
                flyVel.Velocity = cf.RightVector * moveVec.X * Config.FlySpeed +
                                 cf.LookVector * -moveVec.Z * Config.FlySpeed +
                                 Vector3.new(0, up * Config.FlySpeed, 0)
            end
        end)
        flyConnection = conn
        table.insert(Connections, conn)
    end
end

