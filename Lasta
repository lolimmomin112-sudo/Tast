        Callbacks.HopServer = function(sortOrder)
            local HttpService = game:GetService("HttpService")
            local TeleportService = game:GetService("TeleportService")
            local player = game:GetService("Players").LocalPlayer

            local servers = {}
            local cursor = ""

            repeat
                local page
                local ok = pcall(function()
                    local url =
                        "https://games.roblox.com/v1/games/"
                        .. tostring(game.PlaceId)
                        .. "/servers/Public?sortOrder="
                        .. tostring(sortOrder)
                        .. "&limit=100"
                        .. (cursor ~= "" and ("&cursor=" .. cursor) or "")

                    page = HttpService:JSONDecode(game:HttpGet(url))
                end)

                if ok and page and page.data then
                    for _, server in ipairs(page.data) do
                        if server.id ~= game.JobId and server.playing < server.maxPlayers then
                            table.insert(servers, server)
                        end
                    end

                    cursor = page.nextPageCursor or ""
                else
                    cursor = ""
                end
            until cursor == ""

            if #servers > 0 then
                local server = servers[math.random(1, math.min(3, #servers))]
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    player
                )
            else
                TeleportService:Teleport(game.PlaceId, player)
            end
        end

        
        Callbacks.SetReachTransparency = function(text)
            local value = tonumber(text)
            if not value then return end

            if value > 1 then
                value = value / 100
            end

            if getgenv().Reach then
                getgenv().Reach.Transparency = value
            end

            local helper = workspace:FindFirstChild("BallFollowPart")
            if helper then
                helper.Transparency = value
            end
        end

        
        local reachColors = {
            Red = Color3.fromRGB(255, 67, 76),
            Green = Color3.fromRGB(50, 255, 100),
            Blue = Color3.fromRGB(50, 150, 255),
            Yellow = Color3.fromRGB(255, 230, 50),
            Purple = Color3.fromRGB(170, 50, 255),
            Pink = Color3.fromRGB(255, 105, 180),
            Cyan = Color3.fromRGB(0, 255, 255),
            Orange = Color3.fromRGB(255, 140, 0),
            White = Color3.fromRGB(255, 255, 255),
            Black = Color3.fromRGB(30, 30, 30),
        }

        Callbacks.SetReachColor = function(name)
            local color = reachColors[name]
            if not color then return end

            if getgenv().Reach then
                getgenv().Reach.Color = color
            end

            local helper = workspace:FindFirstChild("BallFollowPart")
            if helper then
                helper.Color = color
            end
        end

        
        Callbacks.SetReachSize = function(text)
            local size = tonumber(text)
            if not size then return end

            if getgenv().Reach then
                getgenv().Reach.Size = size
                return
            end

            getgenv().Reach = {
                Enabled = true,
                Size = size,
                Transparency = 0.5,
                Distance = 100,
                Color = Color3.fromRGB(255, 67, 76),
            }

            getgenv().ReachConnections = getgenv().ReachConnections or {}

            local RunService = game:GetService("RunService")
            local Players = game:GetService("Players")
            local player = Players.LocalPlayer
            local footballs = workspace:WaitForChild("Footballs")

            
            local originals = {}
            local tracked = {}

            local function track(part)
                if not part:IsA("BasePart") then return end
                tracked[part] = true
                originals[part] = part.Size
            end

            local function untrack(part)
                tracked[part] = nil
                originals[part] = nil
            end

            for _, child in ipairs(footballs:GetChildren()) do
                track(child)
            end

            table.insert(
                getgenv().ReachConnections,
                footballs.ChildAdded:Connect(track)
            )

            table.insert(
                getgenv().ReachConnections,
                footballs.ChildRemoved:Connect(untrack)
            )

            local function applyReach()
                local edge = Vector3.new(
                    getgenv().Reach.Size,
                    getgenv().Reach.Size,
                    getgenv().Reach.Size
                )

                for part in pairs(tracked) do
                    if part.Parent then
                        part.Size = edge
                        part.Transparency = getgenv().Reach.Transparency
                        part.Material = Enum.Material.ForceField
                        part.Color = getgenv().Reach.Color
                        part.CanCollide = false
                    end
                end
            end

            local function restoreReach()
                for part in pairs(tracked) do
                    if part.Parent then
                        part.Size = originals[part] or part.Size
                        part.Transparency = 0
                        part.Material = Enum.Material.Plastic
                        part.CanCollide = true
                    end
                end
            end

            local follow = workspace:FindFirstChild("BallFollowPart")
            if not follow then
                follow = Instance.new("Part")
            end

            follow.Name = "BallFollowPart"
            follow.Shape = Enum.PartType.Ball
            follow.Size = Vector3.new(2.25, 2.25, 2.25)
            follow.Anchored = true
            follow.CanCollide = true
            follow.CanTouch = false
            follow.CanQuery = false
            follow.Transparency = getgenv().Reach.Transparency
            follow.Material = Enum.Material.ForceField
            follow.Color = getgenv().Reach.Color
            follow.Parent = workspace

            local function nearestFootball(position)
                local best
                local bestDistance = math.huge

                for part in pairs(tracked) do
                    if part.Parent then
                        local distance = (part.Position - position).Magnitude
                        if distance < bestDistance then
                            bestDistance = distance
                            best = part
                        end
                    end
                end

                return best, bestDistance
            end

            table.insert(
                getgenv().ReachConnections,
                RunService.Heartbeat:Connect(function()
                    pcall(function()
                        local character = player.Character
                        local root = character and character:FindFirstChild("HumanoidRootPart")
                        if not root then return end

                        applyReach()

                        local ball, distance = nearestFootball(root.Position)
                        if ball and distance <= getgenv().Reach.Distance then
                            follow.CFrame = ball.CFrame
                        else
                            follow.CFrame = CFrame.new(0, -1000, 0)
                        end
                    end)
                end)
            )

            getgenv().DisableReach = function()
                if getgenv().ReachConnections then
                    for _, connection in ipairs(getgenv().ReachConnections) do
                        if connection and connection.Disconnect then
                            connection:Disconnect()
                        end
                    end
                end

