function WallBangShoot()
    if not CheckPremium("Wall Bang") then return end
    
    local char = GetCharacter()
    local root = GetRootPart()
    local backpack = GetBackpack()
    
    if not char or not root or not backpack then return false end
    
    local gun = char:FindFirstChild("Gun") or backpack:FindFirstChild("Gun")
    if not gun then return false end
    
    local murderer = FindMurderer()
    if not murderer or not murderer.Character then return false end
    
    local mRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    local mHumanoid = murderer.Character:FindFirstChild("Humanoid")
    
    if not mRoot or not mHumanoid or mHumanoid.Health <= 0 then return false end
    
    local ping = 0.06
    local stats = Stats:FindFirstChild("Network")
    if stats then
        local item = stats:FindFirstChild("ServerStatsItem")
        if item then
            local data = item:FindFirstChild("Data Ping")
            if data then
                ping = data:GetValue() / 1000
            end
        end
    end
    
    local predict = ping + 0.05
    predict = math.clamp(predict, 0, 1.2)
    
    local pos = mRoot.Position
    local vel = mRoot.AssemblyLinearVelocity
    
    if vel.Magnitude < 0.1 and mHumanoid.MoveDirection.Magnitude > 0 then
        vel = mHumanoid.MoveDirection * mHumanoid.WalkSpeed
    end
    
    local target = pos + vel * predict
    
    if mHumanoid.FloorMaterial == Enum.Material.Air then
        target = target + Vector3.new(0, 0.5 * Workspace.Gravity * predict^2, 0)
    end
    
    if gun.Parent == backpack then
        gun.Parent = char
        task.wait()
    end
    
    local shoot = gun:FindFirstChild("Shoot")
    if shoot and shoot:IsA("RemoteEvent") then
        task.spawn(function()
            pcall(function()
                shoot:FireServer(CFrame.new(target), CFrame.new(root.Position))
            end)
        end)
        return true
    end
    
    local knifeLocal = gun:FindFirstChild("KnifeLocal")
    if knifeLocal then
        local createBeam = knifeLocal:FindFirstChild("CreateBeam")
        if createBeam then
            local remote = createBeam:FindFirstChild("RemoteFunction")
            if remote then
                task.spawn(function()
                    pcall(function()
                        remote:InvokeServer(1, target, "AH2")
                    end)
                end)
                return true
            end
        end
    end
    
    return false
end

