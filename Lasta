-- ============================================
-- ESP SYSTEM (Simplified)
-- ============================================

RunService.RenderStepped:Connect(function()
    -- Clear old ESP
    for _, v in pairs(ESPObjects) do
        for _, obj in pairs(v) do
            if obj and obj.Remove then
                pcall(obj.Remove, obj)
            end
        end
    end
    ESPObjects = {}
    
    local murderer = FindMurderer()
    local sheriff = FindSheriff()
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local char = p.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if root and humanoid and humanoid.Health > 0 then
                local role = nil
                local color = nil
                
                if murderer and p == murderer then
                    role = "Murderer"
                    color = config.ESPColorMurderer
                elseif sheriff and p == sheriff then
                    role = "Sheriff"
                    color = config.ESPColorSheriff
                elseif FindInnocent(p) then
                    role = "Innocent"
                    color = config.ESPColorInnocent
                end
                
                if role and color then
                    local esp = {}
                    
                    -- Highlight
                    if config["Highlight" .. role] then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "ScripterkiddoHighlight"
                        highlight.FillTransparency = 0.85
                        highlight.OutlineTransparency = 0
                        highlight.FillColor = color
                        highlight.OutlineColor = color
                        highlight.Parent = char
                        esp.Highlight = highlight
                    end
                    
                    -- Info
                    if config["Info" .. role] then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "ScripterkiddoInfo"
                        billboard.Size = UDim2.fromOffset(200, 50)
                        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
                        billboard.AlwaysOnTop = true
                        billboard.Parent = char
                        
                        local label = Instance.new("TextLabel")
                        label.Name = "InfoLabel"
                        label.Size = UDim2.fromScale(1, 1)
                        label.BackgroundTransparency = 1
                        label.TextStrokeTransparency = 0
                        label.Font = Enum.Font.SourceSansBold
                        label.TextSize = 16
                        label.RichText = true
                        label.TextColor3 = color
                        label.Text = p.Name .. "\n<font size='11'>[" .. math.floor((Workspace.CurrentCamera.CFrame.Position - root.Position).Magnitude) .. "]</font>"
                        label.Parent = billboard
                        
                        esp.Info = billboard
                    end
                    
                    ESPObjects[p] = esp
                end
            end
        end
    end
end)

