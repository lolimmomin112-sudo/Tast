local function runCustomScript(source)
	if not source or source:gsub("%s+", "") == "" then
		Rayfield:Notify({ Title = "FOSTOQA Executor", Content = "Script is empty!", Duration = 2 })
		return false, "Empty source"
	end

	local func, loadErr = loadstring(source)
	if not func then
		Rayfield:Notify({ Title = "Syntax Error", Content = tostring(loadErr), Duration = 4 })
		return false, tostring(loadErr)
	end

	local success, runErr = pcall(func)
	if not success then
		Rayfield:Notify({ Title = "Runtime Error", Content = tostring(runErr), Duration = 4 })
		return false, tostring(runErr)
	else
		Rayfield:Notify({ Title = "FOSTOQA Executor", Content = "Executed successfully!", Duration = 2 })
		return true, "Success"
	end
end

