        local function v8NearestFootball()
            local footballs = workspace:FindFirstChild("Footballs")
            if not footballs then
                return nil
            end

            local character = V8LocalPlayer.Character
            if not character then
                return nil
            end

            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if not rootPart then
                return nil
            end

            local best
            local bestDistance = math.huge
            local origin = rootPart.Position

            for _, ball in pairs(footballs:GetChildren()) do
                if ball:IsA("BasePart") then
                    local distance = (ball.Position - origin).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        best = ball
                    end
                end
            end

            return best
        end

        
        
        local function v8NearestPCBall()
            local character = V8LocalPlayer.Character
            if not character then
